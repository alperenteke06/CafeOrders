<Application x:Class="CafeOrders.ServerNotifier.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <SolidColorBrush x:Key="NotifierBackgroundBrush" Color="#E60C1322" />
        <SolidColorBrush x:Key="NotifierSurfaceBrush" Color="#F2141B2B" />
        <SolidColorBrush x:Key="NotifierPanelBrush" Color="#FF191F2F" />
        <SolidColorBrush x:Key="NotifierAccentBrush" Color="#FFFFB800" />
        <SolidColorBrush x:Key="NotifierAccentSoftBrush" Color="#33FFB800" />
        <SolidColorBrush x:Key="NotifierTextBrush" Color="#FFDCE2F7" />
        <SolidColorBrush x:Key="NotifierMutedTextBrush" Color="#FFD5C4AB" />
    </Application.Resources>
</Application>
