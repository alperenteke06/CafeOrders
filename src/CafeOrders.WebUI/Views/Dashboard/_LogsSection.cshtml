@model CafeOrders.WebUI.Models.DashboardViewModel
@using CafeOrders.Application.Contracts.Logging
@{
    var logs = Model.ApplicationLogs.OrderByDescending(x => x.CreatedAtUtc).ToArray();
    var sources = new[]
    {
        ("all", "Tumu", "apps"),
        ("API", "API", "api"),
        ("WebUI", "WebUI", "language"),
        ("DesktopApp", "DesktopApp", "desktop_windows"),
        ("AdminAudioAgent", "Audio Agent", "volume_up")
    };
    var levels = new[]
    {
        ("all", "Tumu"),
        ("Info", "Info"),
        ("Warning", "Uyari"),
        ("Error", "Hata"),
        ("Critical", "Kritik")
    };
    var infoCount = logs.Count(x => x.Level is "Info" or "Information");
    var warningCount = logs.Count(x => x.Level is "Warning" or "Warn");
    var errorCount = logs.Count(x => x.Level is "Error" or "Critical");
}

<section class="content-section section-enter logs-section"
         data-log-source="@Model.LogSourceFilter"
         data-log-level="@Model.LogLevelFilter">
    <div class="section-head">
        <div>
            <h2>Sistem Loglari</h2>
            <p>API, WebUI, DesktopApp ve AdminAudioAgent akislarini tek terminalden izleyin.</p>
        </div>
        <button class="action-button action-button-outline" type="button" onclick="loadSection('logs', false, { source: getLogSourceFilter(), level: getLogLevelFilter(), search: getSearchValue() }, true)">
            <span class="material-symbols-outlined">refresh</span>
            <span>Yenile</span>
        </button>
    </div>

    <div class="log-filter-grid">
        <article class="log-filter-card">
            <span class="filter-label">Log Kaynagi</span>
            <div class="log-chip-row">
                @foreach (var source in sources)
                {
                    <button class="log-filter-chip @(Model.LogSourceFilter == source.Item1 ? "active" : string.Empty)"
                            type="button"
                            onclick="loadSection('logs', true, { source: '@source.Item1', level: getLogLevelFilter(), search: getSearchValue(), page: 1 }, true)">
                        <span class="material-symbols-outlined">@source.Item3</span>
                        <span>@source.Item2</span>
                    </button>
                }
            </div>
        </article>

        <article class="log-filter-card compact">
            <span class="filter-label">Seviye</span>
            <div class="log-chip-row levels">
                @foreach (var level in levels)
                {
                    <button class="log-level-chip @(Model.LogLevelFilter == level.Item1 ? "active" : string.Empty) @LevelCss(level.Item1)"
                            type="button"
                            onclick="loadSection('logs', true, { source: getLogSourceFilter(), level: '@level.Item1', search: getSearchValue(), page: 1 }, true)">
                        <span class="log-level-dot"></span>
                        <span>@level.Item2</span>
                    </button>
                }
            </div>
        </article>
    </div>

    <div class="log-terminal-shell">
        <div class="log-terminal-head">
            <div class="terminal-dots" aria-hidden="true">
                <span class="dot red"></span>
                <span class="dot amber"></span>
                <span class="dot green"></span>
            </div>
            <div class="terminal-title">
                <span class="material-symbols-outlined">lock</span>
                <span>root@jetnet-arena-ops:~/logs</span>
            </div>
            <div class="terminal-actions">
                <span id="applicationLogTotal">@logs.Length</span>
                <span>kayit</span>
            </div>
        </div>

        <div id="applicationLogStream" class="log-terminal-body custom-scrollbar">
            <div class="terminal-scanline" aria-hidden="true"></div>
            @foreach (var log in logs)
            {
                var contextParts = new[]
                {
                    string.IsNullOrWhiteSpace(log.MachineName) ? null : $"Makine: {log.MachineName}",
                    string.IsNullOrWhiteSpace(log.DeviceKey) ? null : $"Cihaz: {log.DeviceKey}",
                    log.TableId.HasValue ? $"Masa: {log.TableId.Value:00}" : null,
                    log.OrderId.HasValue ? $"Siparis: #{log.OrderId.Value}" : null
                }.Where(x => !string.IsNullOrWhiteSpace(x));
                var context = string.Join(" | ", contextParts);

                <article class="log-entry-row @LevelCss(log.Level)" data-log-id="@log.Id" data-log-source="@log.Source" data-log-level="@log.Level">
                    <span class="log-time">[@log.CreatedAtUtc.ToLocalTime().ToString("HH:mm:ss")]</span>
                    <span class="log-source @SourceCss(log.Source)">[@log.Source]</span>
                    <span class="material-symbols-outlined log-icon">@LevelIcon(log.Level)</span>
                    <span class="log-message">
                        @log.Message
                        @if (!string.IsNullOrWhiteSpace(context))
                        {
                            <small class="log-context">@context</small>
                        }
                        @if (!string.IsNullOrWhiteSpace(log.Exception))
                        {
                            <details class="log-exception">
                                <summary>Detay</summary>
                                <pre>@log.Exception</pre>
                            </details>
                        }
                    </span>
                </article>
            }
            <article id="applicationLogEmpty" class="log-empty-state" @(logs.Any() ? "hidden" : string.Empty)>
                <span class="material-symbols-outlined">terminal</span>
                <strong>Bu filtrelerde log bulunamadi</strong>
                <small>Yeni kayitlar geldikce burada canli olarak gorunecek.</small>
            </article>
        </div>
    </div>

    <div class="log-stats-grid">
        <article class="log-stat-card info">
            <span class="material-symbols-outlined">info</span>
            <div>
                <small>Bilgi</small>
                <strong>@infoCount</strong>
            </div>
        </article>
        <article class="log-stat-card warning">
            <span class="material-symbols-outlined">warning</span>
            <div>
                <small>Uyari</small>
                <strong>@warningCount</strong>
            </div>
        </article>
        <article class="log-stat-card error">
            <span class="material-symbols-outlined">error</span>
            <div>
                <small>Hata/Kritik</small>
                <strong>@errorCount</strong>
            </div>
        </article>
    </div>
</section>

@functions {
    private static string LevelCss(string level)
        => level switch
        {
            "Critical" => "critical",
            "Error" => "error",
            "Warning" or "Warn" => "warning",
            "Info" or "Information" => "info",
            _ => "debug"
        };

    private static string SourceCss(string source)
        => source switch
        {
            "API" => "api",
            "WebUI" => "webui",
            "DesktopApp" => "desktop",
            "AdminAudioAgent" => "agent",
            _ => "system"
        };

    private static string LevelIcon(string level)
        => level switch
        {
            "Critical" or "Error" => "error",
            "Warning" or "Warn" => "warning",
            "Info" or "Information" => "info",
            _ => "terminal"
        };

}
