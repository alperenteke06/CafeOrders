<Window x:Class="CafeOrders.SetupWizard.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CafeOrders Setup Wizard"
        Width="1180"
        Height="930"
        MinWidth="1040"
        MinHeight="840"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanResize"
        Background="#07101f"
        Foreground="#f7f0dd"
        FontFamily="Segoe UI"
        Loaded="Window_Loaded">
    <Window.Resources>
        <Storyboard x:Key="SplashExitStoryboard">
            <DoubleAnimation Storyboard.TargetName="SplashOverlay"
                             Storyboard.TargetProperty="Opacity"
                             BeginTime="0:0:1.15"
                             Duration="0:0:0.65"
                             From="1"
                             To="0">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseInOut" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="SplashLogoScale"
                             Storyboard.TargetProperty="ScaleX"
                             Duration="0:0:0.9"
                             From="0.92"
                             To="1.04"
                             AutoReverse="True">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="SplashLogoScale"
                             Storyboard.TargetProperty="ScaleY"
                             Duration="0:0:0.9"
                             From="0.92"
                             To="1.04"
                             AutoReverse="True">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>

        <SolidColorBrush x:Key="Surface" Color="#0b1424" />
        <SolidColorBrush x:Key="SurfaceElevated" Color="#141d31" />
        <SolidColorBrush x:Key="SurfaceSoft" Color="#202b43" />
        <SolidColorBrush x:Key="Accent" Color="#ffb800" />
        <SolidColorBrush x:Key="AccentDim" Color="#8b6711" />
        <SolidColorBrush x:Key="TextPrimary" Color="#fff8e8" />
        <SolidColorBrush x:Key="TextMuted" Color="#b8c0d8" />
        <SolidColorBrush x:Key="Danger" Color="#df4b60" />

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
        </Style>

        <Style x:Key="CaptionText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextMuted}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#ead9b4" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,7" />
        </Style>

        <Style x:Key="InputBox" TargetType="TextBox">
            <Setter Property="Height" Value="46" />
            <Setter Property="Padding" Value="16,0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
            <Setter Property="Background" Value="{StaticResource SurfaceSoft}" />
            <Setter Property="BorderBrush" Value="#34425f" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CaretBrush" Value="{StaticResource Accent}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="16">
                            <ScrollViewer x:Name="PART_ContentHost" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter Property="BorderBrush" Value="{StaticResource Accent}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PasswordInput" TargetType="PasswordBox">
            <Setter Property="Height" Value="46" />
            <Setter Property="Padding" Value="16,0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
            <Setter Property="Background" Value="{StaticResource SurfaceSoft}" />
            <Setter Property="BorderBrush" Value="#34425f" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CaretBrush" Value="{StaticResource Accent}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="PasswordBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="16">
                            <ScrollViewer x:Name="PART_ContentHost" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter Property="BorderBrush" Value="{StaticResource Accent}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ComboInput" TargetType="ComboBox">
            <Setter Property="Height" Value="46" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
            <Setter Property="Background" Value="{StaticResource SurfaceSoft}" />
            <Setter Property="BorderBrush" Value="#34425f" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="IsTextSearchEnabled" Value="True" />
            <Setter Property="MaxDropDownHeight" Value="260" />
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ComboBoxItem">
                        <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
                        <Setter Property="Padding" Value="14,11" />
                        <Setter Property="FontWeight" Value="SemiBold" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ComboBoxItem">
                                    <Border x:Name="ItemRoot"
                                            Margin="4"
                                            Padding="{TemplateBinding Padding}"
                                            Background="#141d31"
                                            BorderBrush="#283650"
                                            BorderThickness="1"
                                            CornerRadius="13">
                                        <ContentPresenter />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsHighlighted" Value="True">
                                            <Setter TargetName="ItemRoot" Property="Background" Value="#202d47" />
                                            <Setter TargetName="ItemRoot" Property="BorderBrush" Value="#ffb800" />
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="ItemRoot" Property="Background" Value="#ffb800" />
                                            <Setter Property="Foreground" Value="#241800" />
                                            <Setter TargetName="ItemRoot" Property="BorderBrush" Value="#ffd36b" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="ToggleButton"
                                          Focusable="False"
                                          ClickMode="Press"
                                          Background="{TemplateBinding Background}"
                                          BorderBrush="{TemplateBinding BorderBrush}"
                                          BorderThickness="{TemplateBinding BorderThickness}"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="Root"
                                                Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                CornerRadius="16">
                                            <Grid>
                                                <ContentPresenter x:Name="ContentSite"
                                                                  Margin="16,0,48,0"
                                                                  HorizontalAlignment="Left"
                                                                  VerticalAlignment="Center"
                                                                  IsHitTestVisible="False"
                                                                  Content="{Binding SelectionBoxItem, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                                                  ContentTemplate="{Binding SelectionBoxItemTemplate, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                                                  ContentStringFormat="{Binding SelectionBoxItemStringFormat, RelativeSource={RelativeSource AncestorType=ComboBox}}" />
                                                <TextBlock Text="⌄"
                                                           Margin="0,0,18,2"
                                                           HorizontalAlignment="Right"
                                                           VerticalAlignment="Center"
                                                           Foreground="#ffd37a"
                                                           FontSize="20"
                                                           FontWeight="Bold" />
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Root" Property="Background" Value="#25314b" />
                                                <Setter TargetName="Root" Property="BorderBrush" Value="#ffb800" />
                                            </Trigger>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="Root" Property="BorderBrush" Value="#ffb800" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>

                            <TextBox x:Name="PART_EditableTextBox"
                                     Margin="16,0,48,0"
                                     HorizontalContentAlignment="Left"
                                     VerticalContentAlignment="Center"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     Foreground="{StaticResource TextPrimary}"
                                     CaretBrush="{StaticResource Accent}"
                                     FontWeight="SemiBold"
                                     Visibility="Hidden"
                                     IsReadOnly="{TemplateBinding IsReadOnly}" />

                            <Popup x:Name="PART_Popup"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   Placement="Bottom"
                                   PopupAnimation="Slide">
                                <Border MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                        MaxHeight="{TemplateBinding MaxDropDownHeight}"
                                        Margin="0,8,0,0"
                                        Padding="6"
                                        Background="#0d1628"
                                        BorderBrush="#384967"
                                        BorderThickness="1"
                                        CornerRadius="16">
                                    <ScrollViewer CanContentScroll="True"
                                                  HorizontalScrollBarVisibility="Disabled"
                                                  VerticalScrollBarVisibility="Auto">
                                        <ItemsPresenter />
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEditable" Value="True">
                                <Setter TargetName="PART_EditableTextBox" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter Property="BorderBrush" Value="{StaticResource Accent}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PackageSourceRadio" TargetType="RadioButton">
            <Setter Property="Height" Value="42" />
            <Setter Property="MinWidth" Value="118" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Root"
                                Background="#121d31"
                                BorderBrush="#30405f"
                                BorderThickness="1"
                                CornerRadius="16"
                                Padding="16,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Ellipse x:Name="Dot" Width="9" Height="9" Fill="#59667e" VerticalAlignment="Center" />
                                <ContentPresenter Grid.Column="2"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#1a2740" />
                                <Setter TargetName="Root" Property="BorderBrush" Value="#ffb800" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#ffb800" />
                                <Setter TargetName="Root" Property="BorderBrush" Value="#ffd36b" />
                                <Setter TargetName="Dot" Property="Fill" Value="#241800" />
                                <Setter Property="Foreground" Value="#241800" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="StepIndicatorText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#7583a1" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Margin" Value="0,0,0,14" />
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Height" Value="48" />
            <Setter Property="Padding" Value="22,0" />
            <Setter Property="Background" Value="{StaticResource Accent}" />
            <Setter Property="Foreground" Value="#261900" />
            <Setter Property="BorderBrush" Value="{StaticResource Accent}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="17">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#ffd05b" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Root" Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="GhostButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="Background" Value="#111b2d" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
            <Setter Property="BorderBrush" Value="#31405e" />
        </Style>

        <Style x:Key="ValidationButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="Height" Value="44" />
            <Setter Property="Background" Value="#161f33" />
            <Setter Property="Foreground" Value="#ffd37a" />
            <Setter Property="BorderBrush" Value="#8b6711" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="16">
                            <Grid>
                                <Border CornerRadius="15" Opacity="0.16">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                            <GradientStop Color="#ffb800" Offset="0" />
                                            <GradientStop Color="#18223a" Offset="1" />
                                        </LinearGradientBrush>
                                    </Border.Background>
                                </Border>
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#202c46" />
                                <Setter TargetName="Root" Property="BorderBrush" Value="#ffb800" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Root" Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SuccessButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="Background" Value="#13d18e" />
            <Setter Property="Foreground" Value="#05150f" />
            <Setter Property="BorderBrush" Value="#13d18e" />
        </Style>

        <Style x:Key="OptionCheckBox" TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Margin" Value="0,0,18,16" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Border x:Name="Root"
                                MinHeight="58"
                                Padding="14,10"
                                Background="#141f34"
                                BorderBrush="#2e3c59"
                                BorderThickness="1"
                                CornerRadius="18">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="34" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border x:Name="Box"
                                        Width="24"
                                        Height="24"
                                        CornerRadius="9"
                                        Background="#0d1628"
                                        BorderBrush="#50607f"
                                        BorderThickness="1.4"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Center">
                                    <Path x:Name="CheckGlyph"
                                          Data="M 5 12 L 10 17 L 19 7"
                                          Stroke="#261900"
                                          StrokeThickness="2.4"
                                          StrokeStartLineCap="Round"
                                          StrokeEndLineCap="Round"
                                          Opacity="0" />
                                </Border>
                                <ContentPresenter Grid.Column="1"
                                                  VerticalAlignment="Center"
                                                  RecognizesAccessKey="True" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#182640" />
                                <Setter TargetName="Root" Property="BorderBrush" Value="#6c5a25" />
                                <Setter TargetName="Box" Property="BorderBrush" Value="#ffb800" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#1d2a42" />
                                <Setter TargetName="Root" Property="BorderBrush" Value="#9b7413" />
                                <Setter TargetName="Box" Property="Background" Value="#ffb800" />
                                <Setter TargetName="Box" Property="BorderBrush" Value="#ffcf5c" />
                                <Setter TargetName="CheckGlyph" Property="Opacity" Value="1" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Root" Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="WindowButton" TargetType="Button">
            <Setter Property="Width" Value="38" />
            <Setter Property="Height" Value="38" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
            <Setter Property="Background" Value="#152036" />
            <Setter Property="BorderBrush" Value="#1f2b43" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="14">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border BorderBrush="#3f3213" BorderThickness="1" Background="{StaticResource Surface}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="64" />
                <RowDefinition Height="*" />
                <RowDefinition Height="82" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="#07101f" Offset="0" />
                        <GradientStop Color="#101a2e" Offset="1" />
                    </LinearGradientBrush>
                </Grid.Background>
                <TextBlock Text="CafeOrders Setup Wizard"
                           Margin="26,0,0,0"
                           VerticalAlignment="Center"
                           FontSize="21"
                           FontWeight="Black"
                           Foreground="{StaticResource Accent}" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,18,0">
                    <Button Style="{StaticResource WindowButton}" Content="-" Click="MinimizeButton_Click" Margin="0,0,10,0" />
                    <Button Style="{StaticResource WindowButton}" Content="X" Click="CloseButton_Click" />
                </StackPanel>
            </Grid>

            <Grid Grid.Row="1" Margin="24,20,24,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="320" />
                    <ColumnDefinition Width="24" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" CornerRadius="26" BorderBrush="#3b2d10" BorderThickness="1" Padding="24">
                    <Border.Background>
                        <RadialGradientBrush Center="0.48,0.18" RadiusX="0.9" RadiusY="0.9">
                            <GradientStop Color="#4a2b04" Offset="0" />
                            <GradientStop Color="#111a2d" Offset="0.48" />
                            <GradientStop Color="#080f1d" Offset="1" />
                        </RadialGradientBrush>
                    </Border.Background>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0">
                            <Border Width="74" Height="74" CornerRadius="24" Background="#ffb800" HorizontalAlignment="Left">
                                <TextBlock Text="⚡" FontSize="38" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#1e1603" />
                            </Border>
                            <TextBlock Text="Adım adım kurulum"
                                       Margin="0,22,0,10"
                                       FontSize="29"
                                       FontWeight="Black"
                                       TextWrapping="Wrap" />
                            <TextBlock Style="{StaticResource CaptionText}"
                                       FontSize="13"
                                       LineHeight="20"
                                       Text="SQL, IIS ve servis seçeneklerini ayrı adımlarda toplayıp Production branch paketini güvenli şekilde kurar." />
                        </StackPanel>

                        <StackPanel Grid.Row="1" VerticalAlignment="Top" Margin="0,22,0,0">
                            <TextBlock x:Name="StepSqlIndicator" Style="{StaticResource StepIndicatorText}" Text="01  SQL bağlantısı" />
                            <TextBlock x:Name="StepIisIndicator" Style="{StaticResource StepIndicatorText}" Text="02  IIS ve paket" />
                            <TextBlock x:Name="StepOptionsIndicator" Style="{StaticResource StepIndicatorText}" Text="03  Kurulum seçenekleri" />
                            <TextBlock x:Name="StepReviewIndicator" Style="{StaticResource StepIndicatorText}" Text="04  Özet ve kurulum" />
                        </StackPanel>

                        <StackPanel Grid.Row="2">
                            <Border Padding="16" CornerRadius="16" Background="#121d31" BorderBrush="#2d3a55" BorderThickness="1">
                                <StackPanel>
                                    <TextBlock Text="Kurulum güvenlikleri" FontWeight="Bold" Foreground="{StaticResource Accent}" />
                                    <TextBlock Style="{StaticResource CaptionText}" Margin="0,10,0,0" Text="IIS/WebSocket/Hosting Bundle ön kontrolü" />
                                    <TextBlock Style="{StaticResource CaptionText}" Margin="0,6,0,0" Text="uploads klasörü korunur" />
                                    <TextBlock Style="{StaticResource CaptionText}" Margin="0,6,0,0" Text="Firewall ve Task Scheduler hazırlanır" />
                                    <TextBlock Style="{StaticResource CaptionText}" Margin="0,6,0,0" Text="appsettings ACL sıkılaştırılır" />
                                </StackPanel>
                            </Border>

                            <Border x:Name="AdminWarningBox" Margin="0,16,0,0" Padding="16" CornerRadius="16" Background="#351822" BorderBrush="#df4b60" BorderThickness="1" Visibility="Collapsed">
                                <TextBlock Style="{StaticResource CaptionText}" Foreground="#ffd0d8" Text="Bu wizard yönetici yetkisiyle çalıştırılmalı. Aksi halde IIS, firewall ve Task Scheduler adımları başarısız olur." />
                            </Border>
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Grid.Column="2" CornerRadius="26" Background="{StaticResource SurfaceElevated}" BorderBrush="#283550" BorderThickness="1">
                    <Grid Margin="28">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0">
                            <TextBlock x:Name="StepTitleText" FontSize="30" FontWeight="Black" />
                            <TextBlock x:Name="StepSubtitleText" Style="{StaticResource CaptionText}" Margin="0,6,0,22" FontSize="14" />
                        </StackPanel>

                        <Border Grid.Row="1" CornerRadius="22" Background="#101928" BorderBrush="#263551" BorderThickness="1" Padding="26">
                            <Grid>
                                <StackPanel x:Name="StepSqlPage">
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="SQL Instance" />
                                    <ComboBox x:Name="SqlInstanceBox" Style="{StaticResource ComboInput}" IsEditable="True" />

                                    <Grid Margin="0,22,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="18" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Style="{StaticResource FieldLabel}" Text="SQL Kullanıcı" />
                                            <TextBox x:Name="SqlUserBox" Style="{StaticResource InputBox}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Style="{StaticResource FieldLabel}" Text="SQL Şifre" />
                                            <PasswordBox x:Name="SqlPasswordBox" Style="{StaticResource PasswordInput}" />
                                        </StackPanel>
                                    </Grid>

                                    <Border Margin="0,24,0,0" Padding="18" CornerRadius="18" Background="#17233a" BorderBrush="#2b3b59" BorderThickness="1">
                                        <TextBlock Style="{StaticResource CaptionText}"
                                                   FontSize="13"
                                                   Text="Bu bilgiler API ve WebUI appsettings dosyalarına yazılır. Kurulum sonunda appsettings dosyalarının ACL izinleri sıkılaştırılır." />
                                    </Border>

                                    <Grid Margin="0,22,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="210" />
                                            <ColumnDefinition Width="18" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Button x:Name="TestSqlButton"
                                                Grid.Column="0"
                                                Style="{StaticResource ValidationButton}"
                                                Content="SQL Bağlantısını Test Et"
                                                Click="TestSqlButton_Click" />
                                        <TextBlock x:Name="SqlTestStatusText"
                                                   Grid.Column="2"
                                                   Style="{StaticResource CaptionText}"
                                                   VerticalAlignment="Center"
                                                   Text="Kuruluma geçmeden önce SQL bilgilerini doğrulayabilirsiniz." />
                                    </Grid>
                                </StackPanel>

                                <StackPanel x:Name="StepIisPage" Visibility="Collapsed">
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="Paket Kaynağı" />
                                    <Border Padding="14" CornerRadius="18" Background="#121d31" BorderBrush="#2c3a58" BorderThickness="1">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="12" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <StackPanel Orientation="Horizontal">
                                                <RadioButton x:Name="RemotePackageRadio"
                                                             Style="{StaticResource PackageSourceRadio}"
                                                             Content="Remote"
                                                             IsChecked="True"
                                                             Checked="PackageSourceRadio_Checked"
                                                             Margin="0,0,10,0" />
                                                <RadioButton x:Name="LocalPackageRadio"
                                                             Style="{StaticResource PackageSourceRadio}"
                                                             Content="Local"
                                                             Checked="PackageSourceRadio_Checked" />
                                            </StackPanel>

                                            <Grid x:Name="RemotePackagePanel" Grid.Row="2">
                                                <TextBox x:Name="PackageUrlBox" Style="{StaticResource InputBox}" />
                                            </Grid>

                                            <Grid x:Name="LocalPackagePanel" Grid.Row="2" Visibility="Collapsed">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="12" />
                                                    <ColumnDefinition Width="158" />
                                                </Grid.ColumnDefinitions>
                                                <TextBox x:Name="PackagePathBox" Style="{StaticResource InputBox}" IsReadOnly="True" />
                                                <Button Grid.Column="2" Style="{StaticResource GhostButton}" Content="Paket Seç" Click="BrowsePackageButton_Click" />
                                            </Grid>
                                        </Grid>
                                    </Border>

                                    <Grid Margin="0,22,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="14" />
                                            <ColumnDefinition Width="130" />
                                            <ColumnDefinition Width="14" />
                                            <ColumnDefinition Width="130" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Style="{StaticResource FieldLabel}" Text="Server IP" />
                                            <ComboBox x:Name="ServerIpBox" Style="{StaticResource ComboInput}" IsEditable="True" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Style="{StaticResource FieldLabel}" Text="API Port" />
                                            <TextBox x:Name="ApiPortBox" Style="{StaticResource InputBox}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="4">
                                            <TextBlock Style="{StaticResource FieldLabel}" Text="WebUI Port" />
                                            <TextBox x:Name="WebUiPortBox" Style="{StaticResource InputBox}" />
                                        </StackPanel>
                                    </Grid>

                                    <TextBlock Style="{StaticResource FieldLabel}" Margin="0,22,0,7" Text="IIS Root Path" />
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="14" />
                                            <ColumnDefinition Width="150" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox x:Name="IisRootPathBox" Style="{StaticResource InputBox}" />
                                        <Button Grid.Column="2" Style="{StaticResource GhostButton}" Content="Klasör Seç" Click="BrowseIisRootButton_Click" />
                                    </Grid>
                                </StackPanel>

                                <StackPanel x:Name="StepOptionsPage" Visibility="Collapsed">
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="Kurulumda çalıştırılacak işlemler" />
                                    <UniformGrid Columns="2" Margin="0,8,0,0">
                                        <CheckBox x:Name="OpenFirewallBox" Style="{StaticResource OptionCheckBox}" Content="5001/5002 firewall rule aç" IsChecked="True" />
                                        <CheckBox x:Name="RegisterTaskBox" Style="{StaticResource OptionCheckBox}" Content="WatchDog task oluştur" IsChecked="True" />
                                        <CheckBox x:Name="TriggerTaskBox" Style="{StaticResource OptionCheckBox}" Content="Kurulum sonunda task tetikle" IsChecked="True" />
                                        <CheckBox x:Name="PreserveUploadsBox" Style="{StaticResource OptionCheckBox}" Content="WebUI uploads klasörünü koru" IsChecked="True" />
                                        <CheckBox x:Name="InstallHostingBundleBox" Style="{StaticResource OptionCheckBox}" Content="Hosting Bundle yoksa kur" IsChecked="True" />
                                    </UniformGrid>

                                    <Border Margin="0,22,0,0" Padding="18" CornerRadius="18" Background="#17233a" BorderBrush="#2b3b59" BorderThickness="1">
                                        <StackPanel>
                                            <TextBlock Text="Önerilen seçim" FontWeight="Bold" Foreground="{StaticResource Accent}" />
                                            <TextBlock Style="{StaticResource CaptionText}" Margin="0,8,0,0" FontSize="13" Text="İlk kurulumda tüm seçeneklerin açık kalması önerilir. Production update sırasında uploads koruma seçeneği özellikle açık kalmalı." />
                                        </StackPanel>
                                    </Border>
                                </StackPanel>

                                <StackPanel x:Name="StepReviewPage" Visibility="Collapsed">
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="Kurulum Özeti" />
                                    <Border Padding="18" CornerRadius="18" Background="#17233a" BorderBrush="#2b3b59" BorderThickness="1">
                                        <TextBlock x:Name="ReviewSummaryText" Style="{StaticResource CaptionText}" FontSize="13" LineHeight="22" />
                                    </Border>

                                    <TextBlock Style="{StaticResource FieldLabel}" Margin="0,20,0,7" Text="Kurulum Logu" />
                                    <Border CornerRadius="22" Background="#0b1322" BorderBrush="#34435f" BorderThickness="1" ClipToBounds="True">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="*" />
                                            </Grid.RowDefinitions>

                                            <Grid Background="#162038" MinHeight="54" Margin="0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Orientation="Horizontal" Margin="22,0,0,0" VerticalAlignment="Center">
                                                    <Ellipse Width="11" Height="11" Fill="#ff5f57" Margin="0,0,8,0" />
                                                    <Ellipse Width="11" Height="11" Fill="#ffbd2e" Margin="0,0,8,0" />
                                                    <Ellipse Width="11" Height="11" Fill="#28c840" />
                                                </StackPanel>
                                                <TextBlock x:Name="DownloadProgressText"
                                                           Grid.Column="1"
                                                           Margin="18,0,24,0"
                                                           VerticalAlignment="Center"
                                                           TextAlignment="Right"
                                                           FontSize="13"
                                                           FontWeight="Bold"
                                                           Foreground="#ffd37a"
                                                           Text="İndirme bekliyor." />
                                            </Grid>

                                            <ScrollViewer x:Name="LogScrollViewer"
                                                          Grid.Row="1"
                                                          Height="330"
                                                          Padding="28,22"
                                                          Background="#07101f"
                                                          HorizontalScrollBarVisibility="Disabled"
                                                          VerticalScrollBarVisibility="Auto">
                                                <TextBlock x:Name="LogTextBlock"
                                                           FontFamily="Cascadia Mono, Consolas"
                                                           FontSize="13.5"
                                                           FontWeight="SemiBold"
                                                           LineHeight="23"
                                                           TextWrapping="Wrap"
                                                           Foreground="#edf4ff" />
                                            </ScrollViewer>
                                        </Grid>
                                    </Border>

                                    <Button x:Name="DownloadDesktopButton"
                                            Margin="0,18,0,0"
                                            Style="{StaticResource SuccessButton}"
                                            Content="DesktopApp'i İndir"
                                            Click="DownloadDesktopButton_Click"
                                            Visibility="Collapsed" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Grid Grid.Row="2" Margin="0,22,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="14" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <Border Height="10"
                                    CornerRadius="5"
                                    Background="#202b43"
                                    BorderBrush="#33425e"
                                    BorderThickness="1"
                                    ClipToBounds="True">
                                <ProgressBar x:Name="InstallProgress"
                                             Height="10"
                                             IsIndeterminate="False"
                                             Foreground="{StaticResource Accent}"
                                             Background="Transparent"
                                             BorderThickness="0" />
                            </Border>

                            <Grid Grid.Row="2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="150" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="190" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="190" />
                                </Grid.ColumnDefinitions>
                                <Button x:Name="BackButton" Grid.Column="1" Style="{StaticResource GhostButton}" Content="Geri" Click="BackButton_Click" />
                                <Button x:Name="PrecheckButton" Grid.Column="3" Style="{StaticResource ValidationButton}" Content="Ön Kontrolü Çalıştır" Click="PrecheckButton_Click" Visibility="Collapsed" />
                                <Button x:Name="NextButton" Grid.Column="5" Style="{StaticResource PrimaryButton}" Content="Devam Et" Click="NextButton_Click" />
                                <Button x:Name="InstallButton" Grid.Column="5" Style="{StaticResource PrimaryButton}" Content="Kurulumu Başlat" Click="InstallButton_Click" Visibility="Collapsed" />
                            </Grid>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>

            <Border Grid.Row="2"
                    Margin="24,0,24,18"
                    Padding="22,14"
                    CornerRadius="18"
                    Background="#101928"
                    BorderBrush="#2d3a55"
                    BorderThickness="1">
                <Grid>
                    <TextBlock Text="CafeOrders @ 2026 Tüm Hakları Saklıdır."
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               FontSize="13"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource TextMuted}" />
                    <StackPanel HorizontalAlignment="Right" VerticalAlignment="Center">
                        <TextBlock Text="YAZILIM GELİŞTİRİCİ"
                                   HorizontalAlignment="Right"
                                   FontSize="10"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource TextMuted}" />
                        <Border Height="1" Width="110" Margin="0,4,0,5" Background="#ffb800" Opacity="0.35" HorizontalAlignment="Right" />
                        <TextBlock Text="Alperen TEKE"
                                   HorizontalAlignment="Right"
                                   FontSize="15"
                                   FontWeight="Black"
                                   Foreground="{StaticResource Accent}" />
                        <TextBlock Text="0 (541) 688 88 06"
                                   HorizontalAlignment="Right"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimary}" />
                    </StackPanel>
                </Grid>
            </Border>

            <Grid x:Name="ModeSelectionOverlay"
                  Grid.RowSpan="3"
                  Panel.ZIndex="88"
                  Visibility="Visible">
                <Grid.Background>
                    <RadialGradientBrush Center="0.5,0.42" RadiusX="0.82" RadiusY="0.82">
                        <GradientStop Color="#1e2c49" Offset="0" />
                        <GradientStop Color="#0b1424" Offset="0.5" />
                        <GradientStop Color="#050b16" Offset="1" />
                    </RadialGradientBrush>
                </Grid.Background>
                <Border Width="720"
                        Padding="34"
                        CornerRadius="30"
                        Background="#111b2d"
                        BorderBrush="#3c4d70"
                        BorderThickness="1.2"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                    <StackPanel>
                        <Border Width="92" Height="92" CornerRadius="28" Background="#ffb800" HorizontalAlignment="Center">
                            <TextBlock Text="⚡" FontSize="48" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#1e1603" />
                        </Border>
                        <TextBlock Text="CafeOrders Setup Wizard"
                                   Margin="0,24,0,8"
                                   HorizontalAlignment="Center"
                                   FontSize="34"
                                   FontWeight="Black" />
                        <TextBlock Text="Kurulum yapmak ya da bu wizard tarafından kurulan bileşenleri kaldırmak için bir işlem seçin."
                                   HorizontalAlignment="Center"
                                   TextAlignment="Center"
                                   Style="{StaticResource CaptionText}"
                                   FontSize="15"
                                   LineHeight="23" />
                        <Grid Margin="0,34,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="18" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0"
                                    Height="68"
                                    Style="{StaticResource PrimaryButton}"
                                    Content="Kurulum Yap"
                                    Click="StartInstallModeButton_Click" />
                            <Button Grid.Column="2"
                                    Height="68"
                                    Style="{StaticResource GhostButton}"
                                    Content="Kaldır"
                                    Click="StartUninstallModeButton_Click" />
                        </Grid>
                    </StackPanel>
                </Border>
            </Grid>

            <Grid x:Name="AppDialogOverlay"
                  Grid.RowSpan="3"
                  Panel.ZIndex="120"
                  Visibility="Collapsed">
                <Grid Background="#c807101f" />
                <Border Width="560"
                        Padding="28"
                        CornerRadius="26"
                        Background="#111b2d"
                        BorderBrush="#3d4d6d"
                        BorderThickness="1.2"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                    <StackPanel>
                        <Border Width="58" Height="58" CornerRadius="18" Background="#ffb800">
                            <TextBlock x:Name="AppDialogIcon" Text="!" FontSize="28" FontWeight="Black" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#1e1603" />
                        </Border>
                        <TextBlock x:Name="AppDialogTitle" Margin="0,18,0,8" FontSize="24" FontWeight="Black" />
                        <TextBlock x:Name="AppDialogMessage" Style="{StaticResource CaptionText}" FontSize="14" LineHeight="22" />
                        <Grid Margin="0,26,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="150" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="150" />
                            </Grid.ColumnDefinitions>
                            <Button x:Name="AppDialogCancelButton" Grid.Column="1" Style="{StaticResource GhostButton}" Content="İptal" Click="AppDialogCancelButton_Click" />
                            <Button x:Name="AppDialogOkButton" Grid.Column="3" Style="{StaticResource PrimaryButton}" Content="Tamam" Click="AppDialogOkButton_Click" />
                        </Grid>
                    </StackPanel>
                </Border>
            </Grid>

            <Grid x:Name="SplashOverlay"
                  Grid.RowSpan="3"
                  Panel.ZIndex="99"
                  IsHitTestVisible="True"
                  Opacity="1">
                <Grid.Background>
                    <RadialGradientBrush Center="0.5,0.42" RadiusX="0.75" RadiusY="0.75">
                        <GradientStop Color="#263556" Offset="0" />
                        <GradientStop Color="#0b1424" Offset="0.44" />
                        <GradientStop Color="#050b16" Offset="1" />
                    </RadialGradientBrush>
                </Grid.Background>
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Border Width="154"
                            Height="154"
                            CornerRadius="38"
                            Background="#111b2d"
                            BorderBrush="#8b6711"
                            BorderThickness="1.5"
                            RenderTransformOrigin="0.5,0.5">
                        <Border.RenderTransform>
                            <ScaleTransform x:Name="SplashLogoScale" ScaleX="0.92" ScaleY="0.92" />
                        </Border.RenderTransform>
                        <Grid>
                            <Ellipse Width="116" Height="116" Fill="#ffb800" Opacity="0.12" />
                            <Image Source="Assets/app-icon.ico" Width="112" Height="112" Stretch="Uniform" />
                        </Grid>
                    </Border>
                    <TextBlock Text="CafeOrders"
                               Margin="0,26,0,0"
                               HorizontalAlignment="Center"
                               FontSize="34"
                               FontWeight="Black"
                               Foreground="{StaticResource Accent}" />
                    <TextBlock Text="Setup hazırlanıyor..."
                               Margin="0,8,0,0"
                               HorizontalAlignment="Center"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource TextMuted}" />
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
